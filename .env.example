# ============================================================
#  Sao chép file này thành  .env  rồi điền giá trị thật.
#  KHÔNG commit file .env lên git.
# ============================================================

# --- Dịch thuật ---
# Chọn 1 trong 2 (theo translate.provider trong config.yaml):
# Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- TikTok Content Posting API ---
# Đăng ký tại https://developers.tiktok.com/
TIKTOK_ACCESS_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Facebook Page (Graph API) ---
# Tạo app tại https://developers.facebook.com/ , lấy Page ID + Page Access Token
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=

# --- Instagram (Graph API, qua Facebook Business) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- (Tuỳ chọn) cookie để tải video bị giới hạn ---
# Đường dẫn tới file cookies.txt xuất từ trình duyệt
COOKIES_FILE=
